# Copy to .env.local for local development, and add the same keys to Render's environment.
# Both values come from Supabase → Project Settings → API. The anon key is safe to expose;
# write access is limited to the owner by the policies in supabase/schema.sql.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: defaults to the email in src/data/portfolioData.js
# VITE_OWNER_EMAIL=muhammadhuanas72@gmail.com
